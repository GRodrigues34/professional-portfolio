---
import SEO from '../components/SEO.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEO title={title} description={description} />
    <SchemaOrg />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Trigger initial masked line reveal
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            root.classList.add('is-ready');
          });
        });

        const heroStage = document.getElementById('inicio');
        const heroCue = document.getElementById('hero-scroll-cue');
        const heroTitle = document.getElementById('hero-title-block');
        const heroCase = document.getElementById('hero-case-preview');

        const clamp = (v, min, max) => Math.max(min, Math.min(max, v));

        let ticking = false;

        const updateStorytelling = () => {
          ticking = false;
          if (reduceMotion) return;

          const vh = window.innerHeight || 1;
          const sy = window.scrollY;
          const isDesktop = window.innerWidth >= 960;

          // Hero Scroll Drift & Cue Fade
          if (heroStage && sy < vh * 1.4) {
            const heroProg = clamp(sy / vh, 0, 1);
            if (heroCue) {
              heroCue.style.opacity = String(clamp(1 - heroProg * 4.5, 0, 1));
            }
            if (heroTitle && isDesktop) {
              heroTitle.style.transform = `translate3d(0, ${-heroProg * 36}px, 0)`;
            }
            if (heroCase && isDesktop) {
              heroCase.style.transform = `translate3d(0, ${-heroProg * 22}px, 0)`;
            }
          }
        };

        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateStorytelling);
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        updateStorytelling();
      })();
    </script>
  </body>
</html>
