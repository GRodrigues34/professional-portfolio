---
import SEO from '../components/SEO.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEO title={title} description={description} />
    <SchemaOrg />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Trigger initial masked line & hero load reveal
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            root.classList.add('is-ready');
          });
        });

        // Set staggered transition delays on .reveal-word inside each heading
        const initHeadingWords = () => {
          document.querySelectorAll('h2').forEach((heading) => {
            const words = heading.querySelectorAll('.reveal-word');
            words.forEach((w, idx) => {
              w.style.transitionDelay = `${idx * 0.06}s`;
            });
          });
        };
        initHeadingWords();

        // =========================================================================
        // 1. GPU-ACCELERATED INTERSECTION OBSERVER FOR ALL SECTION ELEMENTS
        // =========================================================================
        const observedSet = new WeakSet();
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (let i = 0; i < entries.length; i++) {
              const entry = entries[i];
              if (entry.isIntersecting) {
                entry.target.classList.add('is-inview');
              } else if (entry.boundingClientRect.top > window.innerHeight) {
                // Only reset when scrolled below the viewport so elements never vanish mid-read at the top
                entry.target.classList.remove('is-inview');
              }
            }
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -6% 0px',
          }
        );

        const observeRevealTargets = () => {
          const targets = document.querySelectorAll('[data-reveal], [data-reveal-words]');
          targets.forEach((el) => {
            if (!observedSet.has(el)) {
              observedSet.add(el);
              if (reduceMotion) {
                el.classList.add('is-inview');
              } else {
                revealObserver.observe(el);
              }
            }
          });
        };
        observeRevealTargets();

        // Watch for hydrated React islands (e.g. ServicesTimeline) mounting new [data-reveal] nodes
        const domObserver = new MutationObserver(() => {
          observeRevealTargets();
        });
        domObserver.observe(document.body, { childList: true, subtree: true });

        // =========================================================================
        // 2. HERO (#inicio) -> PROJECTS (#projetos) OVERLAPPING CURTAIN (rAF GATED)
        // =========================================================================
        const heroSection = document.getElementById('inicio');
        const heroShade = document.getElementById('hero-exit-shade');
        const heroVisual3D = document.getElementById('hero-visual-3d');
        const heroEls = Array.from(document.querySelectorAll('[data-hero-el]'));

        const projectsSection = document.getElementById('projetos');
        const projectsStage = document.getElementById('projects-sticky-stage');
        const projEls = Array.from(document.querySelectorAll('[data-proj-el]'));
        const projCards = Array.from(document.querySelectorAll('[data-proj-card]'));
        const valuesSection = document.getElementById('valores');

        const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
        const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
        const smoothstep = (t) => t * t * (3 - 2 * t);

        // rAF-throttled 3D mouse-reactive perspective tilt on Hero work snippets
        let pointerTicking = false;
        let lastPointerX = 0;
        let lastPointerY = 0;

        if (heroSection && heroVisual3D && !reduceMotion) {
          heroSection.addEventListener(
            'pointermove',
            (e) => {
              if (window.innerWidth < 960 || window.scrollY > window.innerHeight * 0.45) return;
              lastPointerX = e.clientX;
              lastPointerY = e.clientY;
              if (!pointerTicking) {
                pointerTicking = true;
                requestAnimationFrame(() => {
                  pointerTicking = false;
                  const r = heroSection.getBoundingClientRect();
                  const nx = (lastPointerX - r.left) / r.width - 0.5;
                  const ny = (lastPointerY - r.top) / r.height - 0.5;
                  heroVisual3D.style.transform = `translate3d(${(nx * 16).toFixed(1)}px, ${(ny * 12).toFixed(1)}px, 0) rotateX(${(-ny * 6).toFixed(2)}deg) rotateY(${(nx * 7).toFixed(2)}deg)`;
                });
              }
            },
            { passive: true }
          );

          heroSection.addEventListener('pointerleave', () => {
            heroVisual3D.style.transform = '';
          });
        }

        let scrollTicking = false;
        let curtainSettledBelow = false;

        const updateHeroCurtain = () => {
          scrollTicking = false;
          if (reduceMotion || !heroSection || !projectsSection) return;

          const vh = window.innerHeight || 1;
          const sy = window.scrollY;

          // Skip all DOM rect reads once user has scrolled well past Projects into lower sections
          if (sy > vh * 2.5) {
            if (!curtainSettledBelow) {
              curtainSettledBelow = true;
              if (projectsStage) projectsStage.style.opacity = '';
            }
            return;
          }
          curtainSettledBelow = false;

          const projRect = projectsSection.getBoundingClientRect();
          const riseRaw = clamp(1 - projRect.top / vh, 0, 1);

          // Trigger word-mask reveal on Projects heading once rising past 20%
          projectsSection.classList.toggle('is-revealed', riseRaw > 0.2);

          // A) Hero elements fluidly fade out and recede (pure transform + opacity, zero blur)
          if (heroShade) {
            heroShade.style.opacity = (smoothstep(riseRaw) * 0.88).toFixed(3);
          }

          for (let i = 0; i < heroEls.length; i++) {
            const el = heroEls[i];
            const order = Number(el.getAttribute('data-hero-el') || i);
            const stagger = order * 0.065;
            const elOutRaw = clamp((riseRaw - stagger) / Math.max(0.82 - stagger, 0.25), 0, 1);
            const elOut = smoothstep(elOutRaw);

            if (elOut <= 0.001) {
              el.style.opacity = '';
              el.style.transform = '';
            } else {
              const driftY = -elOut * (40 + order * 10);
              const sc = 1 - elOut * 0.08;
              const op = clamp(1 - elOut * 1.08, 0, 1);

              el.style.opacity = op.toFixed(3);
              el.style.transform = `translate3d(0, ${driftY.toFixed(1)}px, 0) scale(${sc.toFixed(4)})`;
            }
          }

          // B) Projects elements rise up overlapping Hero, then STOP & LOCK when riseRaw === 1
          let projExitRaw = 0;
          if (valuesSection) {
            const valRect = valuesSection.getBoundingClientRect();
            projExitRaw = clamp((vh * 0.88 - valRect.top) / (vh * 0.68), 0, 1);
          }
          const projExit = smoothstep(projExitRaw);

          for (let i = 0; i < projEls.length; i++) {
            const el = projEls[i];
            const order = Number(el.getAttribute('data-proj-el') || i);
            const delay = order * 0.07;
            const inRaw = clamp((riseRaw - delay) / Math.max(0.88 - delay, 0.25), 0, 1);
            const inEased = easeOutCubic(inRaw);

            if (inRaw >= 0.999 && projExitRaw <= 0.001) {
              el.style.opacity = '';
              el.style.transform = '';
            } else {
              const yRise = (1 - inEased) * 72 - projExit * 48;
              const sc = (0.93 + 0.07 * inEased) * (1 - 0.05 * projExit);
              const op = clamp(inEased * (1 - projExit * 0.9), 0, 1);

              el.style.opacity = op.toFixed(3);
              el.style.transform = `translate3d(0, ${yRise.toFixed(1)}px, 0) scale(${sc.toFixed(4)})`;
            }
          }

          for (let c = 0; c < projCards.length; c++) {
            const cardWrap = projCards[c];
            const cardDelay = Math.min(0.12 + c * 0.085, 0.4);
            const cInRaw = clamp((riseRaw - cardDelay) / Math.max(0.92 - cardDelay, 0.25), 0, 1);
            const cIn = easeOutCubic(cInRaw);

            if (cInRaw >= 0.999) {
              cardWrap.style.opacity = '';
            } else {
              cardWrap.style.opacity = clamp(cIn, 0, 1).toFixed(3);
            }
          }

          if (projectsStage && projExitRaw > 0.001) {
            projectsStage.style.opacity = clamp(1 - projExit * 0.85, 0.15, 1).toFixed(3);
          } else if (projectsStage) {
            projectsStage.style.opacity = '';
          }
        };

        const onScroll = () => {
          if (!scrollTicking) {
            scrollTicking = true;
            requestAnimationFrame(updateHeroCurtain);
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        updateHeroCurtain();
      })();
    </script>
  </body>
</html>
