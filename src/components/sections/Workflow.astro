---
const steps = [
  {
    no: "01",
    label: "Descoberta.",
    en: "Discovery",
    text: "Começamos entendendo a fundo o modelo do seu negócio, o perfil do seu cliente, a sua oferta comercial e o objetivo exato que o projeto precisa alcançar.",
  },
  {
    no: "02",
    label: "Direção.",
    en: "Direction",
    text: "Definimos a estrutura de navegação, o roteiro de leitura, a identidade visual e a arquitetura técnica ideal antes de escrever qualquer linha de código.",
  },
  {
    no: "03",
    label: "Desenvolvimento.",
    en: "Development",
    text: "Transformamos a direção aprovada em uma experiência digital rápida, responsiva e sob medida, com engenharia limpa e atenção a cada interação.",
  },
  {
    no: "04",
    label: "Refinamento.",
    en: "Refinement",
    text: "Auditamos velocidade de carregamento, SEO regional, contraste tipográfico e comportamento em celulares e computadores junto com você antes da estreia.",
  },
  {
    no: "05",
    label: "Publicação.",
    en: "Publish",
    text: "Colocamos o projeto no ar em infraestrutura global de alta disponibilidade com certificado SSL, domínio configurado e suporte direto contínuo.",
  },
];
---

<section id="processo" class="relative py-[clamp(80px,12vh,150px)] bg-[#0d0c0b] border-t border-[var(--line)] overflow-hidden">
  <!-- Subtle architectural background wash -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(50% 45% at 28% 45%, rgba(255, 85, 0, 0.08), transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="container-ed relative z-10 space-y-12">
    <!-- Compact Section Header -->
    <div class="grid-12 items-end gap-y-4">
      <div class="col-span-12 md:col-span-3">
        <p class="p-ed text-[#ff5500]">04 / Metodologia</p>
      </div>
      <h2 class="col-span-12 md:col-span-5 h2-ed">
        Da descoberta à <span class="serif-italic font-normal text-[var(--grey)]">publicação.</span>
      </h2>
      <div class="col-span-12 md:col-span-4 max-w-[340px]">
        <p class="p-ed">
          Processo direto em 5 etapas, sem intermediários.
        </p>
      </div>
    </div>

    <!-- Side-by-Side 5-Step Interactive Panel -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      {steps.map((step) => (
        <article class="workflow-card group p-6 sm:p-7 flex flex-col justify-between gap-8 relative overflow-hidden">
          <!-- Ambient hover glow inside step panel -->
          <div
            class="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style="background: radial-gradient(85% 85% at 85% 15%, rgba(255, 85, 0, 0.16), transparent 70%);"
            aria-hidden="true"
          ></div>

          <!-- Top Header: Step Number & English Tag -->
          <div class="relative z-10 flex items-baseline justify-between border-b border-[var(--line)] pb-4">
            <span class="text-[22px] font-medium tracking-[-0.04em] text-[#ff5500] tabular-nums">
              {step.no}
            </span>
            <span class="text-[12px] text-[var(--dim)] group-hover:text-[var(--grey)] transition-colors">
              {step.en}
            </span>
          </div>

          <!-- Step Title & Description -->
          <div class="relative z-10 space-y-3 my-auto">
            <h3 class="text-[clamp(20px,1.45vw,24px)] font-medium tracking-[-0.03em] text-[#faf8f5] leading-tight transition-colors duration-300 group-hover:text-[#ff5500]">
              {step.label}
            </h3>
            <p class="p-ed text-[14px] leading-[1.42] group-hover:text-[#faf8f5]/85 transition-colors">
              {step.text}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
