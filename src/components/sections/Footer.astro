---
const year = new Date().getFullYear();
---

<footer class="footer-curtain">
  <div class="container-ed">
    <!-- Top 12-Col Grid (Enki .footer-cols) -->
    <div class="grid-12 gap-y-10">
      <div class="col-span-6 md:col-span-3 space-y-2">
        <h3 class="p-ed text-[var(--dim)] mb-4">Contato Direto</h3>
        <a
          href="https://wa.me/5535984788359"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]"
        >
          <span class="roll">
            <span class="roll-a">+55 35 98478-8359</span>
            <span class="roll-b" aria-hidden="true">+55 35 98478-8359</span>
          </span>
        </a>
        <a
          href="mailto:contato@gustavorodrigues.dev"
          class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]"
        >
          <span class="roll">
            <span class="roll-a">contato@gustavorodrigues.dev</span>
            <span class="roll-b" aria-hidden="true">contato@gustavorodrigues.dev</span>
          </span>
        </a>
        <a
          href="https://instagram.com/g_rodrigues04"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]"
        >
          <span class="roll">
            <span class="roll-a">Instagram · @g_rodrigues04</span>
            <span class="roll-b" aria-hidden="true">Instagram · @g_rodrigues04</span>
          </span>
        </a>
      </div>

      <div class="col-span-6 md:col-span-3 space-y-2">
        <h3 class="p-ed text-[var(--dim)] mb-4">Navegação</h3>
        <a href="#projetos" class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]">
          <span class="roll"><span class="roll-a">Projetos</span><span class="roll-b" aria-hidden="true">Projetos</span></span>
        </a>
        <a href="#valores" class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]">
          <span class="roll"><span class="roll-a">Valores</span><span class="roll-b" aria-hidden="true">Valores</span></span>
        </a>
        <a href="#servicos" class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]">
          <span class="roll"><span class="roll-a">Serviços e Preços</span><span class="roll-b" aria-hidden="true">Serviços e Preços</span></span>
        </a>
        <a href="#processo" class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]">
          <span class="roll"><span class="roll-a">Processo</span><span class="roll-b" aria-hidden="true">Processo</span></span>
        </a>
        <a href="#sobre" class="block text-[clamp(14px,1.05vw,17px)] text-[#faf8f5]">
          <span class="roll"><span class="roll-a">Sobre</span><span class="roll-b" aria-hidden="true">Sobre</span></span>
        </a>
      </div>

      <div class="col-span-12 md:col-span-4 md:col-start-9 max-w-[360px]">
        <h3 class="p-ed text-[var(--dim)] mb-4">Nota do Estúdio</h3>
        <p class="p-ed white">
          Desenvolvido por Gustavo Rodrigues em Alfenas, MG. Seu site deve transmitir a mesma excelência que o seu negócio entrega pessoalmente.
        </p>
      </div>
    </div>

    <!-- Bottom Monumental Wordmark (Enki .footer-bottom + .footer-big) -->
    <div class="grid-12 items-end mt-[clamp(56px,10vh,130px)] pb-[var(--gutter)]">
      <div
        class="col-span-12 md:col-span-9 text-[22vw] md:text-[16.5vw] font-medium leading-[0.78] tracking-[-0.065em] text-[#faf8f5] select-none pointer-events-none -mb-[0.08em]"
        aria-hidden="true"
      >
        Gustavo<span class="text-[#ff5500]">.</span>
      </div>

      <div class="col-span-12 md:col-span-3 md:justify-self-end md:text-right space-y-2 mt-6 md:mt-0">
        <a href="#inicio" class="inline-block text-[14px] font-medium text-[#faf8f5]">
          <span class="roll">
            <span class="roll-a">Voltar ao topo ↑</span>
            <span class="roll-b" aria-hidden="true">Voltar ao topo ↑</span>
          </span>
        </a>
        <p class="text-[13px] text-[var(--dim)]">
          © {year} Gustavo Rodrigues · Alfenas, MG
        </p>
      </div>
    </div>
  </div>
</footer>
