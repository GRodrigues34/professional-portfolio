---
const manifestoText =
  "Seu cliente forma uma impressão em segundos antes mesmo de falar com você. Construo páginas, sistemas e automações onde direção visual, velocidade sub-segundo e engenharia rigorosa trabalham juntas para converter visitas em negócios reais.";

const words = manifestoText.split(" ");

const ledgerItems = [
  {
    no: "001",
    title: "Carregamento Sub-Segundo",
    tag: "Core Web Vitals · < 1.0s LCP",
    body: "Cada fração de segundo a mais de espera custa leads no tráfego pago. Suas páginas são compiladas em HTML estático puro, abrindo instantaneamente até no 4G.",
  },
  {
    no: "002",
    title: "Zero Templates ou Inchaço",
    tag: "Astro · React · TypeScript",
    body: "Sem WordPress pesado, sem construtores arrasta-e-solta e sem dezenas de plugins vulneráveis. Código limpo, autoral e projetado especificamente para a sua operação.",
  },
  {
    no: "003",
    title: "Rigor de Sistemas Críticos",
    tag: "80.000+ Usuários Impactados",
    body: "A mesma disciplina de engenharia aplicada a sistemas hospitalares e plataformas transacionais dedicada ao site e às automações da sua empresa.",
  },
  {
    no: "004",
    title: "Atendimento Direto 1 a 1",
    tag: "Sem Agências Intermediárias",
    body: "Quem senta para entender o seu modelo de negócio é exatamente quem projeta a interface e escreve o código. Comunicação clara, rápida e sem ruído.",
  },
];
---

<section id="valores" class="bg-[#0a0a0a] border-t border-[var(--line)]">
  <!-- Part A: Pinned Scroll-Scrubbed Manifesto (Enki #about pattern) -->
  <div id="values-scrub-track" class="relative md:min-h-[185vh]">
    <div class="md:sticky md:top-0 min-h-[75svh] md:h-[100svh] flex items-center py-20 md:py-0">
      <div class="container-ed space-y-10">
        <div class="grid-12 items-baseline">
          <p class="col-span-12 md:col-span-3 p-ed text-[#ff5500]">
            02 / Filosofia de Engenharia
          </p>
          <p class="col-span-12 md:col-span-5 p-ed max-w-[380px] mt-2 md:mt-0">
            Criado para empresas e profissionais que recusam páginas genéricas e lentas.
          </p>
        </div>

        <p
          id="values-manifesto"
          class="max-w-[74rem] text-[clamp(26px,3.6vw,60px)] font-medium leading-[1.08] tracking-[-0.032em] text-[#faf8f5]"
          aria-label={manifestoText}
        >
          {words.map((word, idx) => (
            <>
              <span
                class="scrub-word inline-block transition-opacity duration-150"
                data-word-index={idx}
                style="opacity: 0.16;"
              >
                {word}
              </span>{" "}
            </>
          ))}
        </p>
      </div>
    </div>
  </div>

  <!-- Part B: 12-Column Architectural Values Ledger (Enki #reviews pattern) -->
  <div class="container-ed grid-12 items-start py-[clamp(72px,12vh,160px)] border-t border-[var(--line)]">
    <!-- Sticky Aside (Col 1-3) -->
    <aside class="col-span-12 md:col-span-3 md:sticky md:top-[16vh] flex flex-col justify-between gap-10 mb-12 md:mb-0">
      <ul class="space-y-2 text-[14px] font-medium tracking-[-0.02em] text-[var(--grey)]">
        <li class="text-[#faf8f5]">Arquitetura de alta velocidade</li>
        <li>Direção visual sob medida</li>
        <li>SEO técnico nativo</li>
        <li>Automações sem atrito</li>
        <li class="pt-3 text-[#ff5500]">Alfenas, MG · Todo o Brasil</li>
      </ul>

      <!-- Architectural Wireframe Emblem -->
      <div class="w-28 h-28 relative hidden md:flex items-center justify-center border border-[var(--line)]" aria-hidden="true">
        <div class="w-16 h-16 border border-[#ff5500]/60 rotate-45 transition-transform duration-1000 hover:rotate-90"></div>
        <div class="absolute w-2 h-2 bg-[#ff5500]"></div>
      </div>
    </aside>

    <!-- Main Ledger (Col 4-13) -->
    <div class="col-span-12 md:col-span-9 md:col-start-4">
      <h2 class="h2-ed max-w-[13ch] mb-[clamp(44px,6vh,88px)]">
        Por que a engenharia define a sua <span class="serif-italic font-normal text-[var(--grey)]">conversão.</span>
      </h2>

      <div>
        {ledgerItems.map((item) => (
          <article class="ledger-row grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-start group">
            <div class="md:col-span-2 text-[14px] font-medium text-[var(--dim)] group-hover:text-[#ff5500] transition-colors tabular-nums">
              {item.no}
            </div>
            <div class="md:col-span-4">
              <h3 class="text-[clamp(18px,1.5vw,24px)] font-medium tracking-[-0.025em] text-[#faf8f5] leading-tight">
                {item.title}
              </h3>
              <span class="block mt-1.5 text-[13px] text-[var(--dim)]">
                {item.tag}
              </span>
            </div>
            <p class="md:col-span-6 p-ed max-w-[540px] group-hover:text-[#faf8f5] transition-colors">
              {item.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
