---
import ProjectCard from '../ProjectCard.astro';
import { PROJECTS } from '../../data/projects';
---

<section
  id="projetos"
  aria-label="Projetos selecionados"
  class="pt-[clamp(48px,6vh,80px)] pb-[clamp(72px,11vh,140px)] bg-[#0a0a0a] border-t border-[var(--line)]"
>
  <div class="container-ed space-y-10">
    <!-- Compact Editorial Lead-In Header -->
    <div class="grid-12 items-end gap-y-4">
      <div class="col-span-12 md:col-span-3">
        <p class="p-ed text-[#ff5500]">01 / Portfólio selecionado</p>
      </div>
      <h2 class="col-span-12 md:col-span-5 h2-ed">
        Trabalhos que <span class="serif-italic font-normal text-[var(--grey)]">falam</span> por si.
      </h2>
      <div class="col-span-12 md:col-span-4 max-w-[360px]">
        <p class="p-ed">
          Sistemas, sites e automações reais construídos sob medida para gerar autoridade, velocidade e resultado operacional.
        </p>
      </div>
    </div>

    <!-- Side-by-Side Carousel Panel with Lateral Navigation Buttons -->
    <div class="relative flex items-center gap-3 sm:gap-5">
      <!-- Left Lateral Button (brings 1 project at a time) -->
      <button
        type="button"
        id="projects-prev"
        aria-label="Projeto anterior"
        class="project-nav-btn shrink-0"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>

      <!-- Carousel Viewport (3 projects on desktop, 1 on phone) -->
      <div
        id="projects-viewport"
        class="w-full overflow-hidden py-5 px-2 -mx-2"
      >
        <div
          id="projects-track"
          class="flex transition-transform duration-500 ease-[var(--ease)]"
          style="--cards-per-view: 1; --card-gap: 24px; gap: var(--card-gap);"
        >
          {PROJECTS.map((project, idx) => (
            <div
              class="project-carousel-item shrink-0"
              data-project-index={idx}
            >
              <ProjectCard {...project} index={idx} />
            </div>
          ))}
        </div>
      </div>

      <!-- Right Lateral Button (brings 1 project at a time) -->
      <button
        type="button"
        id="projects-next"
        aria-label="Próximo projeto"
        class="project-nav-btn shrink-0"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>

    <!-- Subtle Bottom Pagination Status -->
    <div class="flex items-center justify-between pt-2 border-t border-[var(--line)] text-[13px] text-[var(--dim)]">
      <span>Passe o cursor sobre um projeto para destacar ou use as setas laterais</span>
      <span id="projects-counter" class="font-medium text-[#faf8f5] tabular-nums">
        <span class="text-[#ff5500]" id="projects-current-idx">01</span> / 0{PROJECTS.length}
      </span>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const track = document.getElementById('projects-track');
    const prevBtn = document.getElementById('projects-prev');
    const nextBtn = document.getElementById('projects-next');
    const currentIdxEl = document.getElementById('projects-current-idx');
    const viewport = document.getElementById('projects-viewport');

    if (!track || !prevBtn || !nextBtn || !viewport) return;

    const items = Array.from(track.querySelectorAll('.project-carousel-item'));
    const total = items.length;
    if (total === 0) return;

    let currentIndex = 0;

    const getVisibleCount = () => (window.innerWidth >= 960 ? 3 : 1);

    const updateCarousel = () => {
      const visible = Math.min(getVisibleCount(), total);
      const maxStartIndex = Math.max(0, total - visible);

      if (currentIndex > maxStartIndex) {
        currentIndex = 0;
      } else if (currentIndex < 0) {
        currentIndex = maxStartIndex;
      }

      const gap = window.innerWidth >= 960 ? 24 : 16;
      const viewportWidth = viewport.clientWidth - 16; // account for px-2 (8px * 2)
      const cardWidth = (viewportWidth - gap * (visible - 1)) / visible;

      track.style.setProperty('--card-gap', `${gap}px`);
      items.forEach((item) => {
        item.style.width = `${cardWidth}px`;
      });

      const offset = currentIndex * (cardWidth + gap);
      track.style.transform = `translate3d(${-offset}px, 0, 0)`;

      if (currentIdxEl) {
        currentIdxEl.textContent = String(currentIndex + 1).padStart(2, '0');
      }
    };

    prevBtn.addEventListener('click', () => {
      const visible = Math.min(getVisibleCount(), total);
      const maxStartIndex = Math.max(0, total - visible);
      currentIndex = currentIndex <= 0 ? maxStartIndex : currentIndex - 1;
      updateCarousel();
    });

    nextBtn.addEventListener('click', () => {
      const visible = Math.min(getVisibleCount(), total);
      const maxStartIndex = Math.max(0, total - visible);
      currentIndex = currentIndex >= maxStartIndex ? 0 : currentIndex + 1;
      updateCarousel();
    });

    // Touch swipe support for mobile
    let touchStartX = 0;
    viewport.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0]?.screenX || 0;
      },
      { passive: true }
    );

    viewport.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0]?.screenX || 0;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) nextBtn.click();
          else prevBtn.click();
        }
      },
      { passive: true }
    );

    window.addEventListener('resize', updateCarousel);
    updateCarousel();
  })();
</script>
