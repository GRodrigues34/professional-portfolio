---
import { ParticleCanvas } from '../widgets/ParticleCanvas';
---

<section id="inicio" class="hero-stage relative min-h-[100svh] flex flex-col justify-between overflow-hidden bg-[#0a0a0a]">
  <!-- Interactive Constellation Canvas (Lucas Portfolio pattern) -->
  <ParticleCanvas client:load />

  <!-- Subtle warm radial studio light -->
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(55% 50% at 72% 38%, rgba(255, 85, 0, 0.085), transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Top Editorial Header (Enki 12-column grid) -->
  <header class="container-ed grid-12 items-start pt-[var(--gutter)] relative z-10">
    <a
      href="#inicio"
      class="col-span-7 md:col-span-6 justify-self-start inline-flex items-baseline text-[clamp(40px,4.4vw,82px)] font-medium leading-[0.82] tracking-[-0.055em] text-[#faf8f5]"
      aria-label="Gustavo Rodrigues, início"
    >
      <span>Gustavo</span><span class="text-[#ff5500]">.</span>
    </a>

    <nav
      class="hidden md:flex md:col-span-4 md:col-start-7 flex-col gap-1 text-[clamp(14px,1.05vw,17px)] font-[450] tracking-[-0.025em] text-[#faf8f5]"
      aria-label="Navegação principal"
    >
      <a href="#projetos" class="self-start">
        <span class="roll"><span class="roll-a">Projetos</span><span class="roll-b" aria-hidden="true">Projetos</span></span>
      </a>
      <a href="#valores" class="self-start">
        <span class="roll"><span class="roll-a">Valores</span><span class="roll-b" aria-hidden="true">Valores</span></span>
      </a>
      <a href="#servicos" class="self-start">
        <span class="roll"><span class="roll-a">Serviços e Preços</span><span class="roll-b" aria-hidden="true">Serviços e Preços</span></span>
      </a>
      <a href="#processo" class="self-start">
        <span class="roll"><span class="roll-a">Processo</span><span class="roll-b" aria-hidden="true">Processo</span></span>
      </a>
      <a href="#sobre" class="self-start">
        <span class="roll"><span class="roll-a">Sobre</span><span class="roll-b" aria-hidden="true">Sobre</span></span>
      </a>
    </nav>

    <div class="col-span-5 md:col-span-2 md:col-start-11 justify-self-end">
      <a href="#contato" class="pill-button">
        <span class="roll">
          <span class="roll-a">Contato</span>
          <span class="roll-b" aria-hidden="true">Contato</span>
        </span>
      </a>
    </div>
  </header>

  <!-- Editorial Meta Band with Full-Width 1px Hairline -->
  <div class="container-ed grid-12 pt-[clamp(28px,4.5vh,64px)] pb-5 relative z-10">
    <div class="col-span-12 md:col-span-4 max-w-[320px] space-y-3" data-hero-fade>
      <p class="p-ed white">Como trabalho</p>
      <p class="p-ed">
        Desenvolvo experiências digitais onde direção visual, engenharia de software e velocidade operam como um único sistema.
      </p>
      <p class="p-ed">
        Sem excesso de efeitos que distraem o seu cliente. Clareza imediata do primeiro segundo ao contato comercial.
      </p>
    </div>

    <div class="col-span-12 md:col-span-4 md:col-start-7 max-w-[350px] flex flex-col justify-between gap-6 mt-6 md:mt-0" data-hero-fade>
      <div class="space-y-1.5">
        <p class="p-ed white">Gustavo Rodrigues · Alfenas, MG</p>
        <p class="p-ed">
          Engenheiro de software e consultor independente. Sites de alta conversão, sistemas sob medida e automações inteligentes.
        </p>
      </div>
      <p class="p-ed white inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#ff5500]" aria-hidden="true"></span>
        <span>Agenda aberta para novos projetos</span>
      </p>
    </div>

    <!-- Bottom Hairline -->
    <div class="col-span-12 h-px bg-[var(--line)] mt-2"></div>
  </div>

  <!-- Scroll Cue (Bottom Right) -->
  <div class="scroll-cue" id="hero-scroll-cue" aria-hidden="true">
    <span>Scroll</span>
    <i></i>
  </div>

  <!-- Main Asymmetric Editorial Stage -->
  <div class="container-ed grid-12 flex-1 items-end pb-[var(--gutter)] pt-[clamp(16px,2.5vh,36px)] relative z-10">
    <!-- Left Column: Featured Case Anchor (Enki .hero-case pattern) -->
    <a
      href="#projetos"
      id="hero-case-preview"
      class="col-span-12 md:col-span-4 self-end flex flex-col gap-2.5 w-full max-w-[280px] group order-2 md:order-1 mt-8 md:mt-0"
    >
      <div class="aspect-[16/10] w-full overflow-hidden border border-[var(--line)] bg-[#121212] relative transition-transform duration-700 ease-[var(--ease)] group-hover:scale-[0.97]">
        <!-- Architectural Mini Preview of CSF Steel Frame -->
        <div class="absolute inset-0 p-3.5 flex flex-col justify-between bg-[radial-gradient(80%_80%_at_80%_20%,rgba(255,85,0,0.18),transparent_70%),linear-gradient(160deg,#181716,#0d0d0d)]">
          <div class="flex items-center justify-between text-[10px] text-[var(--dim)] border-b border-[var(--line)] pb-1.5">
            <span>01 / CSF Steel Frame</span>
            <span class="text-[#ff5500]">0.6s LCP</span>
          </div>
          <div class="space-y-1">
            <div class="text-[13px] font-medium text-[#faf8f5] tracking-[-0.02em] leading-tight">
              Catálogo Estrutural &amp; Vitrine de Chalés
            </div>
            <div class="h-1 w-12 bg-[#ff5500]"></div>
          </div>
        </div>
      </div>
      <div class="flex items-center justify-between text-[14px] font-medium text-[#faf8f5] tracking-[-0.02em]">
        <span>Ver projetos entregues</span>
        <span class="text-[#ff5500] transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
      </div>
    </a>

    <!-- Right Column: Monumental Display Headline & Line CTA -->
    <div
      id="hero-title-block"
      class="col-span-12 md:col-span-6 md:col-start-7 flex flex-col justify-between gap-8 md:gap-12 self-stretch order-1 md:order-2"
    >
      <h1 class="h1-ed max-w-[12ch]" aria-label="O site que eleva o patamar do seu negócio.">
        <span class="line-mask"><span class="line-inner">O site que eleva</span></span>
        <span class="line-mask"><span class="line-inner">o patamar do</span></span>
        <span class="line-mask"><span class="line-inner"><em class="serif-italic font-normal text-[#faf8f5]">seu negócio.</em></span></span>
      </h1>

      <div class="flex flex-col gap-4 max-w-[320px]">
        <p class="p-ed">
          Sua presença online deve transmitir a mesma solidez e autoridade que a sua empresa entrega no mundo real.
        </p>
        <a
          href="https://wa.me/5535984788359?text=Ol%C3%A1%20Gustavo!%20Vim%20pelo%20seu%20portf%C3%B3lio%20e%20quero%20conversar%20sobre%20um%20projeto."
          target="_blank"
          rel="noopener noreferrer"
          class="line-link"
        >
          <span class="roll">
            <span class="roll-a">Iniciar conversa no WhatsApp</span>
            <span class="roll-b" aria-hidden="true">Iniciar conversa no WhatsApp</span>
          </span>
          <span class="text-[#ff5500] text-sm">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
