---
import { ParticleCanvas } from '../widgets/ParticleCanvas';
---

<section
  id="inicio"
  class="hero-stage sticky top-0 z-[1] h-[100svh] flex flex-col justify-between overflow-hidden bg-[#0a0a0a]"
>
  <!-- Interactive Constellation Canvas (Lucas Portfolio pattern) -->
  <ParticleCanvas client:load />

  <!-- Subtle warm radial studio light -->
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(55% 50% at 72% 38%, rgba(255, 85, 0, 0.085), transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Fluid dark shade that deepens as Projects rises over Hero -->
  <div
    id="hero-exit-shade"
    class="absolute inset-0 bg-[#0a0a0a] opacity-0 pointer-events-none z-[5]"
    aria-hidden="true"
  ></div>

  <div class="container-ed relative z-10 flex-1 flex flex-col justify-between pt-[clamp(88px,11vh,124px)] pb-[clamp(24px,3.5vh,42px)] gap-6">
    <!-- Main Unified Hero Stage (image_4 architecture) -->
    <div class="grid-12 items-center my-auto gap-y-10">
      <!-- Left Column: Identity Logo, Strong Phrase, Simple Description, Immediate CTAs -->
      <div
        id="hero-title-block"
        class="col-span-12 lg:col-span-6 flex flex-col items-start gap-5 sm:gap-6"
      >
        <!-- Brand / Logo Lockup -->
        <div data-hero-el="0" class="inline-flex items-center gap-3.5 hero-load-item" style="--load-delay: 0.04s;">
          <div class="w-10 h-10 border border-[var(--line)] bg-[#111111] flex items-center justify-center text-[16px] font-medium tracking-[-0.05em] text-[#faf8f5]">
            <span>GR</span><span class="text-[#ff5500]">.</span>
          </div>
          <div class="flex flex-col">
            <span class="text-[14px] font-medium tracking-[-0.02em] text-[#faf8f5] leading-tight">
              Gustavo Rodrigues
            </span>
            <span class="text-[12px] tracking-[-0.01em] text-[var(--dim)] leading-tight mt-0.5">
              Engenharia de Software &amp; Experiências Digitais
            </span>
          </div>
        </div>

        <!-- Monumental Headline with Masked Word Reveal -->
        <h1
          data-hero-el="1"
          class="h1-ed max-w-[12ch]"
          aria-label="O site que eleva o patamar do seu negócio."
        >
          <span class="line-mask"><span class="line-inner">O site que eleva</span></span>
          <span class="line-mask"><span class="line-inner">o patamar do</span></span>
          <span class="line-mask"><span class="line-inner"><em class="serif-italic font-normal text-[#faf8f5]">seu negócio.</em></span></span>
        </h1>

        <!-- Simple Description -->
        <p data-hero-el="2" class="p-ed max-w-[48ch] hero-load-item" style="--load-delay: 0.26s;">
          Experiências digitais personalizadas, sistemas sob medida e automações para profissionais e empresas que querem transformar presença online em credibilidade e vendas.
        </p>

        <!-- Immediate CTAs -->
        <div data-hero-el="3" class="flex flex-wrap items-center gap-3.5 pt-1 hero-load-item" style="--load-delay: 0.34s;">
          <a
            href="https://wa.me/5535984788359?text=Ol%C3%A1%20Gustavo!%20Vim%20pelo%20seu%20portf%C3%B3lio%20e%20quero%20conversar%20sobre%20um%20projeto."
            target="_blank"
            rel="noopener noreferrer"
            class="pill-button"
          >
            <span class="roll">
              <span class="roll-a">Iniciar um projeto</span>
              <span class="roll-b" aria-hidden="true">Iniciar um projeto</span>
            </span>
          </a>

          <a
            href="#projetos"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border border-[var(--line)] bg-[#111111] text-[#faf8f5] text-[clamp(14px,1vw,16px)] font-medium tracking-[-0.02em] hover:border-[#ff5500] transition-colors"
          >
            <span class="roll">
              <span class="roll-a">Ver projetos</span>
              <span class="roll-b" aria-hidden="true">Ver projetos</span>
            </span>
          </a>
        </div>
      </div>

      <!-- Right Column: 3D Mouse-Reactive Fanned Snippets of Works -->
      <div
        id="hero-case-preview"
        data-hero-el="2"
        class="col-span-12 lg:col-span-6 relative min-h-[340px] sm:min-h-[390px] flex items-center justify-center hero-load-item"
        style="--load-delay: 0.18s; perspective: 1000px;"
      >
        <a
          href="#projetos"
          id="hero-visual-3d"
          class="relative w-full max-w-[560px] h-[340px] sm:h-[385px] mx-auto block group transition-transform duration-300 ease-out"
          style="transform-style: preserve-3d;"
          aria-label="Explorar projetos em destaque"
        >
          <!-- Card 3 (Back-Right Snippet) -->
          <div class="browser-window absolute right-0 top-0 w-[58%] sm:w-[56%] rotate-[4deg] opacity-90 transition-transform duration-500 ease-[var(--ease)] group-hover:rotate-[6deg] group-hover:translate-x-2 group-hover:-translate-y-1.5">
            <div class="browser-chrome">
              <div class="browser-dots"><i></i><i></i><i></i></div>
              <span class="browser-url">sisapec.health</span>
              <span class="text-[10px] text-[#ff5500]">SISTEMA</span>
            </div>
            <div class="aspect-[16/10] p-3.5 sm:p-4 flex flex-col gap-2.5 bg-[radial-gradient(80%_80%_at_80%_20%,rgba(255,85,0,0.16),transparent_65%),linear-gradient(155deg,#1c1917,#0d0d0e)]">
              <div class="flex justify-between items-center text-[10px] text-[var(--dim)] border-b border-[var(--line)] pb-1.5">
                <span>03 / Telemetria &amp; Saúde</span>
                <span class="text-[#ff5500]">80k+ Usuários</span>
              </div>
              <div class="space-y-1">
                <div class="text-xs sm:text-sm font-medium text-[#faf8f5] tracking-[-0.02em]">
                  Prontuário &amp; Sinais Vitais
                </div>
                <div class="text-[10px] text-[var(--grey)]">
                  Arquitetura crítica de alta disponibilidade
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2 (Top-Left Snippet) -->
          <div class="browser-window absolute left-0 top-[7%] w-[58%] sm:w-[56%] -rotate-[4deg] opacity-95 transition-transform duration-500 ease-[var(--ease)] group-hover:-rotate-[6deg] group-hover:-translate-x-2 group-hover:-translate-y-1.5 z-10">
            <div class="browser-chrome">
              <div class="browser-dots"><i></i><i></i><i></i></div>
              <span class="browser-url">aurorabookstore.app</span>
              <span class="text-[10px] text-[#ff5500]">PLATAFORMA</span>
            </div>
            <div class="aspect-[16/10] p-3.5 sm:p-4 flex flex-col gap-2.5 bg-[radial-gradient(80%_80%_at_20%_20%,rgba(255,85,0,0.16),transparent_65%),linear-gradient(155deg,#161514,#0b0b0c)]">
              <div class="flex justify-between items-center text-[10px] text-[var(--dim)] border-b border-[var(--line)] pb-1.5">
                <span>02 / E-Commerce Digital</span>
                <span class="text-[#ff5500]">Full-Stack</span>
              </div>
              <div class="space-y-1">
                <div class="text-xs sm:text-sm font-medium text-[#faf8f5] tracking-[-0.02em]">
                  Aurora Editorial &amp; Checkout
                </div>
                <div class="text-[10px] text-[var(--grey)]">
                  Busca instantânea e gestão em tempo real
                </div>
              </div>
            </div>
          </div>

          <!-- Card 1 (Front-Center Main Snippet) -->
          <div class="browser-window absolute left-[18%] bottom-0 w-[66%] sm:w-[64%] -rotate-[1deg] transition-all duration-500 ease-[var(--ease)] group-hover:rotate-[0deg] group-hover:scale-[1.02] group-hover:border-[#ff5500] z-20">
            <div class="browser-chrome">
              <div class="browser-dots"><i></i><i></i><i></i></div>
              <span class="browser-url">csfsteelframe.com.br</span>
              <span class="text-[10px] text-[#ff5500]">0.6s LCP</span>
            </div>
            <div class="aspect-[16/10] p-4 sm:p-5 flex flex-col justify-between bg-[radial-gradient(85%_85%_at_85%_15%,rgba(255,85,0,0.22),transparent_65%),linear-gradient(145deg,#171513,#0b0b0c)]">
              <div class="flex justify-between items-center text-[10px] text-[var(--dim)] border-b border-[var(--line)] pb-2">
                <span class="text-[#faf8f5] font-medium">01 / CSF Steel Frame</span>
                <span class="text-[#ff5500]">100 CWV</span>
              </div>
              <div class="space-y-1.5 my-auto py-1">
                <div class="text-sm sm:text-base font-medium text-[#faf8f5] tracking-[-0.025em] leading-snug">
                  Catálogo Estrutural &amp; Vitrine de Chalés
                </div>
                <p class="text-[11px] text-[var(--grey)] leading-snug">
                  Páginas ultra-rápidas conectadas direto ao WhatsApp comercial.
                </p>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-[var(--line)] text-[10px]">
                <span class="text-[var(--dim)]">Alta conversão</span>
                <span class="text-[#ff5500] font-medium">Ver projetos ↓</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>

    <!-- Bottom Proof Bar (Projects | Attendance Range | Direct Contact) -->
    <div
      data-hero-el="4"
      class="w-full border border-[var(--line)] bg-[#111111]/90 backdrop-blur-md grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--line)] hero-load-item"
      style="--load-delay: 0.42s;"
    >
      <div class="px-6 py-4 sm:px-8 sm:py-5">
        <strong class="block text-[clamp(20px,2vw,28px)] font-medium tracking-[-0.035em] text-[#faf8f5] tabular-nums">
          +10 projetos
        </strong>
        <span class="block mt-1 text-[13px] text-[var(--dim)]">
          entregues para diferentes nichos
        </span>
      </div>

      <div class="px-6 py-4 sm:px-8 sm:py-5">
        <strong class="block text-[clamp(20px,2vw,28px)] font-medium tracking-[-0.035em] text-[#faf8f5]">
          Todo o Brasil
        </strong>
        <span class="block mt-1 text-[13px] text-[var(--dim)]">
          atendimento próximo e 100% online
        </span>
      </div>

      <div class="px-6 py-4 sm:px-8 sm:py-5">
        <strong class="block text-[clamp(20px,2vw,28px)] font-medium tracking-[-0.035em] text-[#faf8f5]">
          Direto
        </strong>
        <span class="block mt-1 text-[13px] text-[var(--dim)]">
          sem agência, sem intermediários
        </span>
      </div>
    </div>
  </div>
</section>
